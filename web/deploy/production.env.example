# Non-secret production settings. Keep passwords/API credentials in your service manager or secret store.
SRMA_WEB_MODE=production
SRMA_WEB_DB=postgres
SRMA_WEB_DATA=/var/lib/srma-web
SRMA_ENGINE_ROOT=/opt/srma-agent-toolkit
SRMA_WEB_HOST=127.0.0.1
SRMA_WEB_PORT=3838
SRMA_TRUSTED_AUTH_PROXY=1
SRMA_AUTH_HEADER=HTTP_X_SRMA_USER
SRMA_PUBLIC_URL=https://srma.example.org
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=srma_web
PGUSER=srma_web
# Scientific runtime paths are operator-managed and must match the approved lock.
SRMA_SCIENTIFIC_RSCRIPT=/opt/R/4.6.1/bin/Rscript
SRMA_SCIENTIFIC_LIBRARY=/var/lib/srma-scientific/library
