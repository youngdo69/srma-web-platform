# Non-secret beta settings. Put database/provider secrets in the service manager or a protected secret store.
SRMA_WEB_MODE=beta
SRMA_WEB_DB=postgres
SRMA_WEB_DATA=/var/lib/srma-web
SRMA_ENGINE_ROOT=/opt/srma-agent-toolkit
SRMA_WEB_HOST=127.0.0.1
SRMA_WEB_PORT=3838
SRMA_TRUSTED_AUTH_PROXY=1
SRMA_AUTH_HEADER=HTTP_X_SRMA_USER
SRMA_PUBLIC_URL=https://srma-beta.example.org
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=srma_web
PGUSER=srma_web
